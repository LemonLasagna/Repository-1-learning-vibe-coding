{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Oidc": {
    "Authority": "https://pharmaos.plant.local/auth/realms/pharmaos",
    "ClientId": "pharmaos-web",
    "ClientSecret": "",
    "Audience": "pharmaos-api",
    "RequireHttpsMetadata": true
  },
  "ConnectionStrings": {
    "Db": "Host=postgres;Database=pharmaos;Username=pharmaos_app_login",
    "AuditDb": "Host=postgres;Database=pharmaos;Username=pharmaos_auditor_login"
  },
  "Session": {
    "CookieName": "__Host-pharmaos",
    "SecureCookies": true,
    "IdleTimeoutMinutes": 15
  },
  "WorkflowAuthoring": {
    "RequireSecondPerson": false
  }
}
