# Written to /etc/nginx/conf.d/default.conf at start, with PLATFORM_URL and DNS_RESOLVER filled in.
# Behind the gateway, which ends TLS and sets X-Forwarded-Proto; reached directly, the scheme is what nginx sees.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # The platform host is looked up when a request arrives, not when nginx starts, so web can start before platform.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    # The API, the browser session and the health checks belong to the platform host.
    location ~ ^/(api|bff|health|signin-oidc|signout-callback-oidc)(/|$) {
        set $platform ${PLATFORM_URL};
        proxy_pass $platform;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
    }

    # The Angular router owns every other path.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
