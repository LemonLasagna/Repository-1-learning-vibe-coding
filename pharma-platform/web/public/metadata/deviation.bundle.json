{
  "entity": "DEVIATION",
  "entityLabel": "Deviation",
  "bundleVersion": "DEV_DEFAULT v3 / DEVIATION_STD v5",
  "workflowState": "INVESTIGATION",
  "fields": [
    {
      "code": "title",
      "label": "Title",
      "type": "text",
      "required": true,
      "maxLength": 1000
    },
    {
      "code": "classification",
      "label": "Classification",
      "type": "lookup",
      "required": true,
      "options": [
        {
          "code": "MINOR",
          "label": "Minor"
        },
        {
          "code": "MAJOR",
          "label": "Major"
        },
        {
          "code": "CRITICAL",
          "label": "Critical"
        }
      ]
    },
    {
      "code": "occurred_at",
      "label": "Occurred at",
      "type": "datetime",
      "required": true,
      "help": "Site time zone."
    },
    {
      "code": "description",
      "label": "Description",
      "type": "longtext",
      "required": true
    },
    {
      "code": "is_planned",
      "label": "Planned deviation",
      "type": "boolean"
    },
    {
      "code": "planned_justification",
      "label": "Justification for planned deviation",
      "type": "longtext"
    },
    {
      "code": "qa_owner",
      "label": "QA owner",
      "type": "lookup",
      "options": [
        {
          "code": "skeller",
          "label": "S. Keller"
        },
        {
          "code": "mroth",
          "label": "M. Roth"
        }
      ]
    },
    {
      "code": "batches_affected",
      "label": "Batches affected",
      "type": "number",
      "unit": "batches"
    },
    {
      "code": "impact_assessment",
      "label": "Product impact assessment",
      "type": "longtext"
    },
    {
      "code": "root_cause_summary",
      "label": "Root cause summary",
      "type": "longtext"
    },
    {
      "code": "shift",
      "label": "Shift (site field)",
      "type": "lookup",
      "options": [
        {
          "code": "EARLY",
          "label": "Early"
        },
        {
          "code": "LATE",
          "label": "Late"
        },
        {
          "code": "NIGHT",
          "label": "Night"
        }
      ]
    }
  ],
  "sections": [
    {
      "code": "event",
      "title": "Event",
      "fields": [
        "title",
        "classification",
        "occurred_at",
        "shift",
        "description",
        "is_planned",
        "planned_justification"
      ]
    },
    {
      "code": "assessment",
      "title": "Assessment",
      "fields": [
        "qa_owner",
        "batches_affected",
        "impact_assessment",
        "root_cause_summary"
      ],
      "visibleWhen": {
        "!=": [
          {
            "var": "classification"
          },
          null
        ]
      }
    }
  ],
  "stateAccess": {
    "title": "read",
    "occurred_at": "read",
    "root_cause_summary": "required"
  },
  "rules": [
    {
      "code": "R-PLANNED-JUSTIFY",
      "effect": "hide",
      "fields": [
        "planned_justification"
      ],
      "when": {
        "not": {
          "var": "is_planned"
        }
      }
    },
    {
      "code": "R-PLANNED-REQUIRED",
      "effect": "require",
      "fields": [
        "planned_justification"
      ],
      "when": {
        "var": "is_planned"
      }
    },
    {
      "code": "R-MAJOR-QA",
      "effect": "require",
      "fields": [
        "qa_owner",
        "impact_assessment"
      ],
      "when": {
        "in": [
          {
            "var": "classification"
          },
          [
            "MAJOR",
            "CRITICAL"
          ]
        ]
      }
    },
    {
      "code": "R-MINOR-NO-BATCHES",
      "effect": "hide",
      "fields": [
        "batches_affected"
      ],
      "when": {
        "==": [
          {
            "var": "classification"
          },
          "MINOR"
        ]
      }
    }
  ],
  "transitions": [
    {
      "action": "request_info",
      "label": "Request information"
    },
    {
      "action": "submit_review",
      "label": "Submit for QA review",
      "signatureMeaning": "REVIEWED",
      "signatureMeaningLabel": "Reviewed",
      "signatureStatement": "I have reviewed the investigation and impact assessment and submit them for QA review."
    }
  ]
}
