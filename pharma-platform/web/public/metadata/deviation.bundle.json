{
  "entity": "qms.deviation",
  "entityLabel": "Deviation",
  "bundleVersion": "DEV_DEFAULT v4 / DEVIATION_STD v1",
  "workflowState": "*",
  "fields": [
    { "code": "title", "label": "Title", "type": "text", "required": true, "maxLength": 1000 },
    {
      "code": "classification", "label": "Classification", "type": "lookup", "required": true,
      "help": "QA confirms the classification at triage.",
      "options": [
        { "code": "MINOR", "label": "Minor" },
        { "code": "MAJOR", "label": "Major" },
        { "code": "CRITICAL", "label": "Critical" }
      ]
    },
    {
      "code": "deviation_type", "label": "Type", "type": "lookup", "required": true,
      "options": [
        { "code": "PROCESS", "label": "Process" },
        { "code": "EQUIPMENT", "label": "Equipment" },
        { "code": "MATERIAL", "label": "Material" },
        { "code": "DOCUMENTATION", "label": "Documentation" },
        { "code": "ENVIRONMENT", "label": "Environment" },
        { "code": "OTHER", "label": "Other" }
      ]
    },
    { "code": "occurred_at", "label": "Occurred at", "type": "datetime", "required": true, "help": "Your local time; stored with its UTC offset." },
    {
      "code": "shift", "label": "Shift (site field)", "type": "lookup",
      "options": [
        { "code": "EARLY", "label": "Early" },
        { "code": "LATE", "label": "Late" },
        { "code": "NIGHT", "label": "Night" }
      ]
    },
    { "code": "description", "label": "Description", "type": "longtext", "required": true, "maxLength": 20000 },
    { "code": "is_planned", "label": "Planned deviation", "type": "boolean" },
    { "code": "planned_justification", "label": "Justification for planned deviation", "type": "longtext", "maxLength": 2000 },
    { "code": "immediate_action", "label": "Immediate action taken", "type": "longtext", "maxLength": 20000 },
    { "code": "batches_affected", "label": "Batches affected", "type": "number", "unit": "batches" },
    { "code": "impact_assessment", "label": "Product impact assessment", "type": "longtext", "maxLength": 20000,
      "help": "Needed before approval for major and critical deviations." },
    { "code": "root_cause_summary", "label": "Root cause summary", "type": "longtext", "maxLength": 20000,
      "help": "Needed before submitting for QA approval." },
    { "code": "risk_score", "label": "Risk score (RPN)", "type": "number", "help": "Severity × occurrence × detectability, 1–125." },
    { "code": "due_date", "label": "Due date", "type": "date", "help": "30 days from discovery unless QA sets another at triage." }
  ],
  "sections": [
    {
      "code": "event", "title": "Event",
      "fields": ["title", "classification", "deviation_type", "occurred_at", "shift", "description", "is_planned", "planned_justification", "immediate_action"]
    },
    {
      "code": "investigation", "title": "Investigation",
      "fields": ["batches_affected", "impact_assessment", "root_cause_summary", "risk_score", "due_date"],
      "visibleWhen": { "!=": [{ "var": "classification" }, null] }
    }
  ],
  "stateAccess": {},
  "rules": [
    { "code": "R-PLANNED-JUSTIFY", "effect": "hide", "fields": ["planned_justification"], "when": { "not": { "var": "is_planned" } } },
    { "code": "R-PLANNED-REQUIRED", "effect": "require", "fields": ["planned_justification"], "when": { "var": "is_planned" } },
    { "code": "R-MINOR-NO-BATCHES", "effect": "hide", "fields": ["batches_affected"], "when": { "==": [{ "var": "classification" }, "MINOR"] } }
  ],
  "transitions": []
}
